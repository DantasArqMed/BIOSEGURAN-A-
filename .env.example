# GEMINI_API_KEY: Configuração de chave de API para serviços de IA (se aplicável).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: URL base de hospedagem da aplicação.
# Utilizado para links de redirecionamento, callbacks de OAuth e endpoints de API.
APP_URL="MY_APP_URL"

# Firebase Credentials para Admin SDK (Vercel/Produção)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
