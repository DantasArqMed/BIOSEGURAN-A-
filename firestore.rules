// Standard rules for BioSegurança ArqMed
// Updated: 2026-05-11 02:40
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isVerified() {
       return request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      let emailLower = request.auth.token.email.lower();
      let allowedEmails = [
        'admin@admin.com',
        'dantasarqmed@gmail.com',
        'davidallanos16@gmail.com',
        'bioseguranca@hotmail.com'
      ];
      
      return isSignedIn() && (
        emailLower in allowedEmails ||
        request.auth.token.admin == true ||
        request.auth.token.isAdmin == true ||
        request.auth.token.role in ['admin', 'equipe'] ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo in ['admin', 'equipe'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['admin', 'equipe'] ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAdmin', false) == true
        ))
      );
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin() || (isSignedIn() && getUserData().tipo == 'empresa' && getUserData().loginVisivel == resource.data.get('empresaId', ''));
      allow list: if isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /asoDocuments/{docId} {
      allow read: if isAdmin() || 
                  (isSignedIn() && getUserData().tipo == 'empresa' && getUserData().loginVisivel == resource.data.cnpjEmpresaNormalizado) ||
                  (isSignedIn() && (getUserData().tipo == 'funcionario' || getUserData().tipo == 'aso_funcionario') && getUserData().loginVisivel == resource.data.cpfFuncionarioNormalizado);
      allow write: if isAdmin();
    }

    match /settings/branding {
      allow read: if true; // Public read for login page
    }

    match /contracts/{contractId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid;

      allow read: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
          || (
            exists(/databases/$(database)/documents/users/$(request.auth.uid))
            && (
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.tipo == 'funcionario'
              || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'funcionario'
            )
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isAsoUser', false) != true
          )
        );

      allow update, delete: if request.auth != null
        && (
          resource.data.userId == request.auth.uid
          || isAdmin()
        );
    }

    match /logs/{logId} {
      function isValidLog(data) {
        return data.keys().hasAll(['usuarioId', 'acao', 'data']) &&
               data.usuarioId is string &&
               data.acao is string && data.acao.size() <= 200 &&
               data.data is string;
      }

      allow list, get: if isAdmin();
      allow create: if isSignedIn() && isValidLog(request.resource.data);
      allow update, delete: if false;
    }

    match /companies/{cnpj} {
      function isValidCompany(data) {
        return data.keys().hasAll(['cnpj', 'nome']) &&
               data.cnpj is string && data.cnpj.size() == 14 &&
               data.nome is string && data.nome.size() <= 200;
      }

      allow get: if isAdmin() || (isSignedIn() && getUserData().tipo == 'empresa' && getUserData().loginVisivel == cnpj) ||
                  (isSignedIn() && 
                   (getUserData().tipo == 'funcionario' || getUserData().role == 'funcionario') && 
                   getUserData().get('isAsoUser', false) != true);
      allow list: if isAdmin() || (isSignedIn() && 
                   (getUserData().tipo == 'funcionario' || getUserData().role == 'funcionario') && 
                   getUserData().get('isAsoUser', false) != true);
      allow create, update: if isAdmin() && isValidCompany(request.resource.data);
      allow delete: if isAdmin();

      match /asos/{asoId} {
        allow read: if isAdmin() || 
                    (isSignedIn() && getUserData().tipo == 'empresa' && getUserData().loginVisivel == cnpj) ||
                    (isSignedIn() && getUserData().tipo == 'funcionario' && getUserData().loginVisivel == resource.data.funcionarioCpfLimpo);
        allow write: if isAdmin();
      }

      match /funcionarios/{funcId} {
        allow read: if isAdmin() || (isSignedIn() && getUserData().tipo == 'empresa' && getUserData().loginVisivel == cnpj);
        allow write: if isAdmin();
      }
    }

    // Rules for collectionGroup queries (Employees looking for their ASOs)
    match /{path=**}/asos/{asoId} {
      allow read: if isAdmin() || 
                  (isSignedIn() && getUserData().tipo == 'empresa' && getUserData().loginVisivel == resource.data.empresaId) ||
                  (isSignedIn() && getUserData().tipo == 'funcionario' && getUserData().loginVisivel == resource.data.funcionarioCpfLimpo);
    }

    match /{path=**}/funcionarios/{funcId} {
      allow read: if isAdmin() || (isSignedIn() && getUserData().tipo == 'empresa' && getUserData().loginVisivel == resource.data.empresaId);
    }

    function isInstitutionalAdmin() {
      return isSignedIn() && request.auth.token.email.lower() in [
        'admin@admin.com',
        'dantasarqmed@gmail.com',
        'davidallanos16@gmail.com',
        'bioseguranca@hotmail.com'
      ];
    }

    match /siteConfig/{docId} {
      allow read: if true;
      allow write: if isInstitutionalAdmin();
    }
  }
}
